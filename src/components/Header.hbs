<header>
    <nav>
        <ul>
            {{#each navegacion}}
                <li><a href="{{nav_enlace}}">{{nav_texto}}</a></li>
            {{/each}}
        </ul>
    </nav>
    <div class="perfil">
        <div class="perfil-texto">
            <h1>{{perfil_nombre}}</h1>
            <p class="rol">{{perfil_rol}}</p>
        </div>
        <div class="marco-foto">
            <img src="{{perfil_foto_url}}" alt="{{perfil_foto_alt}}">
        </div>
    </div>
</header>